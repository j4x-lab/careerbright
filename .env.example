# Copy to .env and fill in
# Neon Singapore (pooled). Get yours at neon.tech → Connection Details (pooler).
# DDL lives in packages/db/prisma/schema.sql, seed in seed.sql (applied via psql:
#   psql "$DATABASE_URL" -f packages/db/prisma/schema.sql
#   psql "$DATABASE_URL" -f packages/db/prisma/seed.sql)
DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
BETTER_AUTH_SECRET="change-me-32-chars-min"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
XENDIT_SECRET_KEY=""
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
WA_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
