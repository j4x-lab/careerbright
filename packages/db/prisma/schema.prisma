generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  LSP_ASSESSOR
  EMPLOYER
  UNIVERSITY
  CONTRIBUTOR
}

enum RoleCategory {
  TECH
  GREEN
  FINANCE
  PM
  MINING
  MARKETING
  SALES
}

enum AssessmentType {
  CODE_CHALLENGE
  SOFT_SKILL_SIM
  PROJECT
  MCQ
  PORTFOLIO
}

enum SubmissionStatus {
  PENDING
  GRADING
  GRADED
  NEEDS_HUMAN_REVIEW
  FAILED
}

enum CredentialType {
  MICRO_BADGE
  PATHWAY_CREDENTIAL
  LSP_CERTIFICATE
}

model CompetencyFramework {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  nameEn    String?
  sector    String
  kkniLevel Int
  version   String           @default("1.0")
  status    String           @default("Active")
  units     CompetencyUnit[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CompetencyUnit {
  id          String               @id @default(cuid())
  code        String               @unique
  title      String
  titleEn    String?
  description String?
  frameworkId String
  framework   CompetencyFramework  @relation(fields: [frameworkId], references: [id])
  level       Int                  @default(1)
  milestones  LearningPathMilestone[]
}

model LearningPath {
  id             String         @id @default(cuid())
  slug           String         @unique
  titleId        String
  titleEn        String
  category       RoleCategory
  targetRole     String
  targetKkniLevel Int
  salaryMin      Int
  salaryMax      Int
  demandLevel    String         @default("HIGH")
  estimatedWeeks Int
  price          Int            @default(0)
  lspCertPrice   Int?
  lspPartnerId   String?
  milestones     LearningPathMilestone[]
  enrollments    UserLearningPath[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LearningPathMilestone {
  id               String          @id @default(cuid())
  learningPathId   String
  learningPath     LearningPath    @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  titleId          String
  titleEn          String?
  order            Int
  competencyUnitId String?
  competencyUnit   CompetencyUnit? @relation(fields: [competencyUnitId], references: [id])
  skkniUnitCode    String
  assessmentId     String?
  isRequired       Boolean         @default(true)

  @@unique([learningPathId, order])
}

model AppUser {
  id               String   @id @default(cuid())
  email            String   @unique
  phone            String?  @unique
  name             String
  role             UserRole @default(STUDENT)
  kkniLevel        Int?
  nik              String?  @unique
  ktpVerified      Boolean  @default(false)
  language         String   @default("id")
  timezone         String   @default("Asia/Jakarta")
  enrollments      UserLearningPath[]
  submissions      AssessmentSubmission[]
  credentials      Credential[]
  orders           Order[]
  courses          Course[]
  // Practice-platform (Exec Summary) fields
  subscriptionTier String   @default("FREE")
  subscriptionEndsAt DateTime?
  campusLicenseId  String?
  campusLicense    CampusLicense? @relation(fields: [campusLicenseId], references: [id])
  missionAttempts  MissionAttempt[]
  portfolioEntries PortfolioEntry[]
  contributorProfile Contributor?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserLearningPath {
  id                String       @id @default(cuid())
  userId            String
  user              AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPathId    String
  learningPath      LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  status            String       @default("ACTIVE")
  currentMilestone  Int          @default(0)
  progress          Float        @default(0)
  completedAt       DateTime?
  lspUpgradeStatus  String       @default("NONE")
  lspUpgradePaidAt  DateTime?
  startedAt         DateTime     @default(now())

  @@unique([userId, learningPathId])
}

model Assessment {
  id           String         @id @default(cuid())
  titleId      String
  titleEn      String?
  type         AssessmentType
  aiConfig     Json?
  timeLimit    Int?
  maxAttempts  Int            @default(3)
  passingScore Int            @default(70)
  starterCode  String?
  testCases    Json?
  language     String?
  scenarioConfig Json?
  submissions  AssessmentSubmission[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AssessmentSubmission {
  id            String           @id @default(cuid())
  assessmentId  String
  assessment    Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId        String
  user          AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String?
  output        String?
  conversation  Json?
  status        SubmissionStatus @default(PENDING)
  score         Float?
  feedback      Json?
  confidence    Float?
  gradedBy      String?
  attemptNumber Int              @default(1)
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?

  @@index([userId, assessmentId])
}

model Credential {
  id                   String         @id @default(cuid())
  userId               String
  user                 AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 CredentialType
  vcJson               Json?
  obJson               Json?
  verificationUrl      String         @unique
  qrCodeUrl            String?
  pdfUrl               String?
  lspId                String?
  lspCertificateNumber String?        @unique
  bnspVerified         Boolean        @default(false)
  issuedAt             DateTime       @default(now())
  expiresAt            DateTime?
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  user           AppUser  @relation(fields: [userId], references: [id])
  orderNumber    String   @unique
  status         String   @default("PENDING")
  totalAmount    Int
  currency       String   @default("IDR")
  paymentGateway String   @default("MIDTRANS")
  gatewayOrderId String?
  gatewayPayload Json?
  // Practice-platform order types: SUBSCRIPTION | CAMPUS_LICENSE | LSP_UPGRADE
  type           String   @default("LSP_UPGRADE")
  missionId      String?
  campusLicenseId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---- Professional Practice Platform (Exec Summary 5-step loop) ----

enum MissionStatus {
  DRAFT
  CURATION_PENDING
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AI_REVIEWED
  NEEDS_HUMAN_REVIEW
  GRADED
  REVISED
}

enum ArtifactMode {
  DOCUMENT
  SPREADSHEET
  IMAGE
  LINK
  CODE
}

enum FeedbackStatus {
  AI_GENERATED
  HUMAN_APPROVED
  HUMAN_OVERRIDDEN
}

enum ContributorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model Mission {
  id              String        @id @default(cuid())
  slug            String        @unique
  roleId          String
  titleId         String
  titleEn         String?
  briefId         String
  briefEn         String?
  deliverableSpec Json
  rubric          Json
  skkniUnitCode   String
  kkniLevel       Int           @default(5)
  difficulty      Int           @default(1)
  estimatedMin    Int           @default(60)
  maxRevisions    Int           @default(3)
  status          MissionStatus @default(DRAFT)
  authorId        String?
  author          Contributor?  @relation(fields: [authorId], references: [id])
  reviewerId      String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attempts        MissionAttempt[]
  portfolioEntries PortfolioEntry[]
  payouts         ContributorPayout[]

  @@index([roleId, status])
  @@index([status, publishedAt])
}

model MissionAttempt {
  id           String        @id @default(cuid())
  missionId    String
  mission      Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId       String
  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNum   Int           @default(1)
  status       AttemptStatus @default(IN_PROGRESS)
  score        Float?
  confidence   Float?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  reviewedAt   DateTime?
  artifacts    SubmissionArtifact[]
  aiFeedback   AIFeedback?
  revisions    Revision[]
  portfolioEntry PortfolioEntry?

  @@unique([missionId, userId, attemptNum])
  @@index([userId, missionId])
  @@index([status, submittedAt])
}

model SubmissionArtifact {
  id        String       @id @default(cuid())
  attemptId String
  attempt   MissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revisionId String?
  revision  Revision?    @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  mode      ArtifactMode
  content   String
  metadata  Json?
  order     Int          @default(0)

  @@index([attemptId, order])
}

model AIFeedback {
  id              String         @id @default(cuid())
  attemptId       String         @unique
  attempt         MissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  criterionScores Json
  consensusScore  Float
  confidence      Float
  feedbackId      String
  feedbackEn      String?
  reflectionId    String?
  reflectionEn    String?
  promptVersion   String         @default("judge-v1")
  status          FeedbackStatus @default(AI_GENERATED)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
}

model Revision {
  id           String   @id @default(cuid())
  attemptId    String
  attempt      MissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revisionNum  Int
  noteId       String?
  createdAt    DateTime @default(now())
  artifacts    SubmissionArtifact[]

  @@unique([attemptId, revisionNum])
}

model PortfolioEntry {
  id             String   @id @default(cuid())
  userId         String
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id])
  attemptId      String   @unique
  attempt        MissionAttempt @relation(fields: [attemptId], references: [id])
  briefSnapshot  Json
  artifacts      Json
  rubricSnapshot Json
  aiFeedback     Json?
  revisions      Json?
  reflectionId   String?
  reflectionEn   String?
  isPublic       Boolean  @default(true)
  publishedAt    DateTime @default(now())

  @@index([userId, publishedAt])
  @@index([missionId, publishedAt])
}

model Contributor {
  id            String            @id @default(cuid())
  userId        String            @unique
  user          AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  bioId         String?
  bioEn         String?
  expertise     String[]
  status        ContributorStatus @default(PENDING)
  payoutRate    Int               @default(750)
  totalEarnings Int               @default(0)
  bankName      String?
  bankAccount   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  missions      Mission[]
  payouts       ContributorPayout[]
}

model CampusLicense {
  id           String        @id @default(cuid())
  universityId String
  name         String
  contactEmail String
  seats        Int
  pricePerSeat Int
  startsAt     DateTime
  endsAt       DateTime
  status       LicenseStatus @default(ACTIVE)
  inviteCode   String        @unique @default(cuid())
  members      AppUser[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([universityId, status])
}

model ContributorPayout {
  id            String      @id @default(cuid())
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  missionId     String
  mission       Mission     @relation(fields: [missionId], references: [id])
  completions   Int
  amount        Int
  method        String      @default("MANUAL")
  reference     String?
  periodStart   DateTime
  periodEnd     DateTime
  paidAt        DateTime?
  status        PayoutStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  @@index([contributorId, status])
}

// ---- Phase 1: LMS content ----
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id           String       @id @default(cuid())
  slug         String       @unique
  titleId      String
  titleEn      String?
  description  String?
  status       CourseStatus @default(DRAFT)
  instructorId String?
  instructor   AppUser?     @relation(fields: [instructorId], references: [id])
  modules      Module[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleId  String
  order    Int      @default(0)
  lessons  Lesson[]
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titleId  String
  type     String @default("READING")
  order    Int    @default(0)
  content  Json?
}

// ---- Phase 1: Better Auth core tables (standard schema) ----
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  phoneNumber   String?   @unique
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---- Wave release gate (discovery content) ----
// Which roles' micro-scenarios are playable. A missing row means LOCKED, so
// newly committed roles/scenarios stay dark until an admin releases them.
// Runtime access is raw pg (see apps/web/src/server/routers/admin.ts), not
// Prisma — `prisma generate` cannot run on Android.
model RoleRelease {
  roleId    String   @id
  released  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
