{
  "name": "@careerbright/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "node ../../node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "db:push": "node ../../node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma",
    "db:seed": "node ../../node_modules/tsx/dist/cli.mjs ./src/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
