{
  "name": "superbright",
  "version": "0.4.0",
  "private": true,
  "description": "Career SuperBright — Indonesia AI-Powered Career Readiness Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@careerbright/web",
    "build": "npm run build --workspace=@careerbright/web",
    "lint": "npm run lint --workspace=@careerbright/web",
    "prod": "npm start --workspace=@careerbright/web",
    "serve": "npm run build --workspace=@careerbright/web && npm start --workspace=@careerbright/web",
    "typecheck": "npm run typecheck --workspace=@careerbright/web",
    "db:generate": "npm run db:generate --workspace=@careerbright/db",
    "db:push": "npm run db:push --workspace=@careerbright/db",
    "db:seed": "npm run db:seed --workspace=@careerbright/db"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
